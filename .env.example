# Copie este arquivo para ".env" e preencha.
# Só o TELEGRAM_TOKEN é obrigatório aqui — o resto dá para configurar pelo painel
# (http://localhost:8080) depois que o bot estiver rodando.

# ===== Telegram =====
# Token do @BotFather
TELEGRAM_TOKEN=
# Seu ID do Telegram (mande /start para o bot que ele te responde com o número).
# Também dá para cadastrar pelo painel.
ALLOWED_USER_IDS=

# ===== Painel =====
PANEL_PORT=8080
# Opcional: senha para abrir o painel
PANEL_PASSWORD=

# ===== Instagram =====
# Opcional: dá para colar o token pelo painel. Se colar aqui, ele é usado na
# primeira vez; depois o bot renova sozinho e guarda em data/ig_token.json.
IG_ACCESS_TOKEN=
GRAPH_VERSION=v25.0

# ===== Valores iniciais (depois o painel e o Telegram mandam) =====
# feed (post/reel/carrossel), story ou both
DEFAULT_DESTINATION=feed
CONFIRM_BEFORE_POST=false
KEEP_ORIGINAL_CAPTION=false
DEFAULT_CAPTION=""
# Use ASPAS, senão tudo depois do primeiro espaço + # é ignorado
HASHTAGS=""
SKIP_DUPLICATES=true
PAD_COLOR=#000000
MAX_CAROUSEL_ITEMS=10

# ===== Download =====
# Opcional: caminho de um cookies.txt. Mais fácil: enviar o arquivo pelo painel.
COOKIES_FILE=

# ===== Hospedagem temporária das mídias =====
# Vazio = túnel gratuito do Cloudflare (precisa do cloudflared instalado).
PUBLIC_BASE_URL=
CLOUDFLARED_PATH=cloudflared
LOCAL_PORT=8787
